{
  "name": "@madebythread/thread-kit",
  "version": "1.6.0",
  "description": "Toolkit for sanity studio",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/Thread-Creative/thread-kit#readme",
  "bugs": {
    "url": "https://github.com/Thread-Creative/thread-kit/issues"
  },
  "license": "MIT",
  "author": "Kegan Sovay <kegan@madebythread.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thread-Creative/thread-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.2",
    "@sanity/ui": "^4.2.1",
    "@sanity/util": "^6.9.2",
    "lucide-react": "^1.44.0",
    "react-icons": "^5.7.0",
    "speakingurl": "^14.0.1"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.0",
    "@sanity/plugin-kit": "^10.0.9",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.13.1",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^6.9.2",
    "styled-components": "^6.1.15"
  },
  "overrides": {
    "@sanity/plugin-kit": {
      "@sanity/pkg-utils": "$@sanity/pkg-utils",
      "oxfmt": "$oxfmt"
    }
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "nodeEngine": false
    }
  }
}
